if skaffold render fails try making a yml file for each secret

apiVersion: v1
kind: Secret
metadata:
  name: ai-env
type: Opaque
stringData:
  GROQ_API_KEY: ${GROQ_API_KEY}
  GEMINI_API_KEY: ${GEMINI_API_KEY}
  OLLAMA_BASE_URL: ${OLLAMA_BASE_URL}
  MISTRAL_API_KEY: ${MISTRAL_API_KEY}

---
apiVersion: v1
kind: Secret
metadata:
  name: jwt
type: Opaque
stringData:
  JWT_SECRET: {$JWT_SECRET}
---
apiVersion: v1
kind: Secret
metadata:
  name: databse
type: Opaque
stringData:
  AUTH_MONGO_URI: ${AUTH_MONGO_URI}
  SANDBOX_MONGO_URI: ${SANDBOX_MONGO_URI}
  AI_MONGO_URI: ${AI_MONGO_URI}
  NOTIFICATION_MONGO_URI: ${NOTIFICATION_MONGO_URI}
  REDIS_URL: ${REDIS_URL}
  RABBITMQ_URL: ${RABBITMQ_URL}
  RABBITMQ_PORT: ${RABBITMQ_PORT}
---
apiVersion: v1
kind: Secret
metadata:
  name: google
type: Opaque
stringData:
  GOOGLE_CLIENT_ID: ${GOOGLE_CLIENT_ID}
  GOOGLE_SECRET_KEY: ${GOOGLE_SECRET_KEY}
  GOOGLE_REFRESH_TOKEN: ${GOOGLE_REFRESH_TOKEN}
  GOOGLE_USER: ${GOOGLE_USER}

---
apiVersion: v1
kind: Secret
metadata:
  name: urls
type: Opaque
stringData:
  FRONTEND_URL: http://localhost:5173

---
apiVersion: v1
kind: Secret
metadata:
  name: aws
type: Opaque
stringData:
 AWS_REGION: ${AWS_REGION}
 AWS_ACCESS_KEY_ID: ${AWS_ACCESS_KEY_ID}
 AWS_SECRET_ACCESS_KEY: #{AWS_SECRET_ACCESS_KEY}