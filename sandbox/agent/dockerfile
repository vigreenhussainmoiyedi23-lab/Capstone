FROM node:22-bullseye

WORKDIR /app
# Install system dependencies required to build native Node addons
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*
    
COPY package*.json ./

RUN npm install

COPY . .

EXPOSE 3000

RUN mkdir -p /workspace

CMD ["node", "server.js"]